# Server Configuration
NODE_ENV=development
PORT=3000
HTTPS_PORT=3443
ENABLE_HTTPS=false

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/bank_management_db"

# JWT Secret (use a strong random string in production)
JWT_SECRET=your-secret-key-here-change-in-production

# SSL/TLS Certificates (BMS-SR-001: TLS 1.2+ enforcement)
SSL_KEY_PATH=./certs/server-key.pem
SSL_CERT_PATH=./certs/server-cert.pem

# Data Encryption Key (32-byte Base64-encoded key for AES-256-GCM encryption at rest)
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# Email Configuration for OTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password

# Real Mobile SMS Gateway Configuration
# 1. Fast2SMS (Free Indian Mobile SMS - Sign up at https://www.fast2sms.com to get instant free API key)
FAST2SMS_API_KEY=

# 2. Twilio SMS (Global cellular SMS - https://www.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 3. Msg91 (India OTP - https://msg91.com)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
