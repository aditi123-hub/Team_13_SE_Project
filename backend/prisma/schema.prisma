
generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int      @id @default(autoincrement())
  fullName        String
  email           String   @unique
  mobile          String?  @unique
  governmentIdNum String?  @unique
  passwordHash    String
  role            UserRole @default(CUSTOMER)
  failedLogins    Int      @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  accounts               Account[]
  performedTransactions  Transaction[] @relation("PerformedTransactions")
  loans                  Loan[]        @relation("LoanApplicant")
  reviewedLoans          Loan[]        @relation("LoanReviewer")
}

enum UserRole {
  CUSTOMER
  TELLER
  MANAGER
  ADMIN
}

model KycApplication {
  id              Int               @id @default(autoincrement())
  referenceNumber String            @unique
  userId          Int
  accountType     AccountType
  status          KycStatus         @default(PENDING)
  rejectionReason String?
  reviewedBy      Int?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  documents       KycDocument[]
  account Account?
}

model KycDocument {
  id             Int            @id @default(autoincrement())
  applicationId  Int
  documentType   String
  documentValue  String
  application    KycApplication @relation(fields: [applicationId], references: [id])
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountType {
  SAVINGS
  CURRENT
}


model AuditLog {
  id           Int      @id @default(autoincrement())
  userId       Int?
  event        String
  outcome      String
  timestamp    DateTime @default(now())
  previousHash String?
  recordHash   String?

  @@index([timestamp])
}

model UserSession {
  id             String   @id @default(uuid())
  userId         Int
  lastActivityAt DateTime @default(now())
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
model AvailabilityCheck {
  id             Int      @id @default(autoincrement())
  checkedAt      DateTime @default(now())
  isHealthy      Boolean
  responseTimeMs Int?
  statusCode     Int?

  @@index([checkedAt])
  @@index([isHealthy, checkedAt])
}

model AvailabilityIncident {
  id          Int       @id @default(autoincrement())
  startedAt   DateTime  @default(now())
  recoveredAt DateTime?
  reason      String?
  createdAt   DateTime  @default(now())

  @@index([startedAt])
  @@index([recoveredAt])
}

model ScheduledMaintenance {
  id          Int      @id @default(autoincrement())
  startAt     DateTime
  endAt       DateTime
  description String?
  createdAt   DateTime @default(now())

  @@index([startAt, endAt])
}

enum AccountStatus {
  PENDING
  ACTIVE
  CLOSED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum LoanStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model Account {
  id            Int           @id @default(autoincrement())
  accountNumber String        @unique
  userId        Int
  applicationId Int           @unique
  accountType   AccountType
  balance       Decimal       @default(0) @db.Decimal(18, 2)
  status        AccountStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user                  User          @relation(fields: [userId], references: [id])
  application           KycApplication @relation(fields: [applicationId], references: [id])
  sourceTransactions    Transaction[] @relation("SourceAccount")
  destinationTransactions Transaction[] @relation("DestinationAccount")

  @@index([userId])
  @@index([createdAt])
}

model Transaction {
  id                  Int               @id @default(autoincrement())
  referenceNumber     String            @unique
  type                TransactionType
  sourceAccountId     Int?
  destinationAccountId Int?
  amount              Decimal           @db.Decimal(18, 2)
  status              TransactionStatus @default(PENDING)
  performedBy         Int
  createdAt           DateTime          @default(now())

  sourceAccount      Account? @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccount Account? @relation("DestinationAccount", fields: [destinationAccountId], references: [id])
  performer          User     @relation("PerformedTransactions", fields: [performedBy], references: [id])

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
}

model Loan {
  id              Int        @id @default(autoincrement())
  referenceNumber String     @unique
  userId          Int
  requestedAmount Decimal    @db.Decimal(18, 2)
  tenureMonths    Int
  purpose         String
  status          LoanStatus @default(SUBMITTED)
  remarks         String?
  reviewedBy      Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  applicant User  @relation("LoanApplicant", fields: [userId], references: [id])
  reviewer  User? @relation("LoanReviewer", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([status, createdAt])
}
