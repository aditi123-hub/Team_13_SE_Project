
generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int      @id @default(autoincrement())
  fullName        String
  email           String   @unique
  mobile          String?  @unique
  governmentIdNum String?  @unique
  passwordHash    String
  role            UserRole @default(CUSTOMER)
  failedLogins    Int      @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum UserRole {
  CUSTOMER
  TELLER
  MANAGER
  ADMIN
}

model KycApplication {
  id              Int               @id @default(autoincrement())
  referenceNumber String            @unique
  userId          Int
  accountType     AccountType
  status          KycStatus         @default(PENDING)
  rejectionReason String?
  reviewedBy      Int?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  documents       KycDocument[]
}

model KycDocument {
  id             Int            @id @default(autoincrement())
  applicationId  Int
  documentType   String
  documentValue  String
  application    KycApplication @relation(fields: [applicationId], references: [id])
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountType {
  SAVINGS
  CURRENT
}


model AuditLog {
  id           Int      @id @default(autoincrement())
  userId       Int?
  event        String
  outcome      String
  timestamp    DateTime @default(now())
  previousHash String?
  recordHash   String?

  @@index([timestamp])
}

model UserSession {
  id             String   @id @default(uuid())
  userId         Int
  lastActivityAt DateTime @default(now())
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
model AvailabilityCheck {
  id             Int      @id @default(autoincrement())
  checkedAt      DateTime @default(now())
  isHealthy      Boolean
  responseTimeMs Int?
  statusCode     Int?

  @@index([checkedAt])
  @@index([isHealthy, checkedAt])
}

model AvailabilityIncident {
  id          Int       @id @default(autoincrement())
  startedAt   DateTime  @default(now())
  recoveredAt DateTime?
  reason      String?
  createdAt   DateTime  @default(now())

  @@index([startedAt])
  @@index([recoveredAt])
}

model ScheduledMaintenance {
  id          Int      @id @default(autoincrement())
  startAt     DateTime
  endAt       DateTime
  description String?
  createdAt   DateTime @default(now())

  @@index([startAt, endAt])
}

model Account {
  id              Int           @id @default(autoincrement())
  userId          Int
  accountType     AccountType
  balance         Float         @default(0)
  dailyTransferred Float        @default(0)
  lastTransferDate DateTime?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sentTransactions     Transaction[] @relation("SentTransactions")
  receivedTransactions Transaction[] @relation("ReceivedTransactions")

  @@index([userId])
}

model Transaction {
  id              Int      @id @default(autoincrement())
  referenceNumber String   @unique
  fromAccountId   Int
  toAccountId     Int
  amount          Float
  note            String?
  createdAt       DateTime @default(now())
  fromAccount     Account  @relation("SentTransactions", fields: [fromAccountId], references: [id])
  toAccount       Account  @relation("ReceivedTransactions", fields: [toAccountId], references: [id])

  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([createdAt])
}

model Loan {
  id              Int        @id @default(autoincrement())
  referenceNumber String     @unique
  userId          Int
  amount          Float
  purpose         String
  status          LoanStatus @default(PENDING)
  remarks         String?
  reviewedBy      Int?
  reviewedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId])
  @@index([status])
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
}